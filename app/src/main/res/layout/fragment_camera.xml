<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_black">

    <!-- Full-screen camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Hand skeleton overlay -->
    <com.signapp.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Commit flash -->
    <View
        android:id="@+id/flash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/accent"
        android:clickable="false"
        android:focusable="false" />

    <!-- ═══════════════════════════════════════════════
         TOP BAR
         ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.20"
                android:shadowColor="@color/accent"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="12"
                android:text="HANDY"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/counter_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="0 SIGNS"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/camera_switch_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Switch camera"
                android:src="@drawable/baseline_cameraswitch_24"
                android:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Bottom border line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════
         CENTER ZONE — gesture label + confidence
         Fills all space between top_bar and history_scroll
         ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/gesture_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@id/history_scroll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <!-- Live detected gesture — auto-sizes so it never overflows -->
        <TextView
            android:id="@+id/gesture_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="72sp"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="@color/accent"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="24"
            android:text="…"
            android:textColor="@color/text_primary"
            android:textSize="72sp"
            android:textStyle="bold" />

        <!-- Confidence bar — thin clean line -->
        <ProgressBar
            android:id="@+id/confidence_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="3dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_confidence_bar" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════
         HISTORY CHIPS — anchored just above bottom panel
         ═══════════════════════════════════════════════ -->
    <HorizontalScrollView
        android:id="@+id/history_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/history_chips_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- ═══════════════════════════════════════════════
         BOTTOM PANEL
         ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Top border line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Sentence output -->
        <TextView
            android:id="@+id/subtitle_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:hint="MAKE A SIGN TO BEGIN"
            android:maxLines="2"
            android:minHeight="52dp"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp">

            <!-- Clear all -->
            <ImageButton
                android:id="@+id/delete_button"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_neon_button"
                android:contentDescription="Clear all"
                android:src="@drawable/baseline_delete_forever_24"
                android:tint="@color/danger" />

            <!-- Delete last word -->
            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_neon_button"
                android:contentDescription="Delete last word"
                android:src="@drawable/baseline_arrow_back_24"
                android:tint="@color/text_primary" />

            <!-- Space -->
            <Button
                android:id="@+id/space_button"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_neon_button"
                android:contentDescription="Add space"
                android:text="SP"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.10"
                android:textStyle="bold" />

            <!-- Copy -->
            <ImageButton
                android:id="@+id/copy_button"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_neon_button"
                android:contentDescription="Copy text"
                android:src="@drawable/ic_copy"
                android:tint="@color/text_primary" />

            <!-- Share -->
            <ImageButton
                android:id="@+id/share_button"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_neon_button"
                android:contentDescription="Share sentence"
                android:src="@drawable/ic_share"
                android:tint="@color/text_primary" />

            <!-- Speak all — accent circle -->
            <ImageButton
                android:id="@+id/fab_speak"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/accent"
                android:contentDescription="Speak sentence"
                android:src="@drawable/ic_volume_up"
                android:tint="@color/deep_black" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>